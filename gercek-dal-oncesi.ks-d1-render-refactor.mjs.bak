let __kosan = 0; /* SAYAÇ KAPISI: yalnız t() assertion çağrıları sayılır (catch-only dahil, kosan=beklenen manifest) */
process.on("exit", (c) => { if (c !== 0) return; if (__kosan !== 45) { console.error("SUITE_DONE UYUŞMAZLIĞI: ks-d1-render-refactor.mjs kosan=" + __kosan + " beklenen=45"); process.exitCode = 1; } else { console.log("SUITE_DONE:ks-d1-render-refactor.mjs:" + __kosan + ":45"); } });
/* ks-d1-render-refactor.mjs — D1 RENDER SAHİPLİĞİ ÇATIŞMASI KAPANIŞ SÜİTİ (GERÇEK DOM semantiği)
   TEK İŞ: ek-ders.js renderYonetim override'ı + yonetimBolum.innerHTML sahiplik çatışmasının
   D0 kalıcı-host sınırıyla çözüldüğünü KOD DOKUNUŞU OLMADAN kanıtlar (madde F).
   Kanıt zinciri:
   1) app.js renderYonetim markup'ında kart-içi donemSeciciKutu VAR (sahiplik üreticisi).
   2) ek-ders.js override markup'ında donemSeciciKutu YOK (silici taraf — root cause kaydı).
   3) Önce/sonra semantic DOM snapshot eşitliği: boot + 3 render + 4 alt sekme + geri dönüş
      akışında beşli id, aktif dönem seçimi, şablon kaynak/hedef seçimleri, aktif sekme
      pill'i, veri (ders/istek/sinifProg/donemler) ve localStorage byte-birebir korunur.
   4) Override yb.innerHTML'i yazsa bile host yb'nin KARDEŞİ kalır ve silinemez.
   5) Duplicate id yok; DB referans kimlikleri değişmez.
   D0 süiti yardımcıları (ks-render-sahipligi.mjs) yeniden kullanıldı (aynı mock semantiği).
   Test.mjs'e tam 1 kez bağlanır. */
import { readFileSync } from "node:fs";

const appKaynak = readFileSync("app.js", "utf8");
const ekKaynak = readFileSync("ek-ders.js", "utf8");
const html = readFileSync("index.html", "utf8");
const inlineBloklar = [...html.matchAll(/<script(?![^>]*src=)[^>]*>([\s\S]*?)<\/script>/g)].map((m) => m[1]).join("\n;\n");
let n = 0, fail = 0;
const t = (ad, kosul, extra) => { __kosan++;  n++; if (!kosul) fail++; console.log((kosul ? "✓ " : "✗ ") + ad + (extra !== undefined ? " → " + extra : "")); };

/* ---- A) Kaynak düzeyi root-cause kanıtı (salt-okuma) ---- */
const appRenderYonetim = appKaynak.slice(appKaynak.indexOf("function renderYonetim()"), appKaynak.indexOf("/* ---- Öğretmenler ---- */"));
t("app.js renderYonetim markup'ı kart-içi donemSeciciKutu üretiyor", (appRenderYonetim.match(/donemSecKutusuHTML\(\)/g) || []).length === 1);
t("ek-ders.js override markup'ı donemSeciciKutu ÜRETMEZ (root cause)", !(ekKaynak.includes('id="donemSeciciKutu"')));
t("ek-ders.js override yb.innerHTML'i bir kez yazıyor (silici atama)", (ekKaynak.match(/\$\("yonetimBolum"\)\.innerHTML =/g) || []).length === 1);
t("app.js override karşıt kanıtı: donemHostOnar host'u yb KARDEŞİ olarak kurar", (appKaynak.match(/\(yb\.parentNode \|\| document\.body\)\.insertBefore\(yeni, yb\)/g) || []).length === 1);
t("app.js sec() alt sekme değişiminde onarım planlıyor", appKaynak.includes("function sec(ad) { ui.sekme = ad; renderYonetim(); donemOnarimPlanla(); kartKolonOnar(); }"));

/* ---- B) Gerçek DOM mock (D0 semantiğiyle aynı) ---- */
class MutationObserverSim {
  constructor(cb) { this._cb = cb; this._hedef = null; }
  observe(hedef) { this._hedef = hedef || null; if (hedef) { hedef._izleyiciler = hedef._izleyiciler || []; hedef._izleyiciler.push(this); } }
  disconnect() { if (this._hedef && this._hedef._izleyiciler) this._hedef._izleyiciler = this._hedef._izleyiciler.filter((x) => x !== this); }
  takeRecords() { return []; }
}
function gercekDomKur(store) {
  const REGISTRY = Object.create(null);
  const ALL_ELS = [];
  function El(id) {
    const e = {
      tagName: "DIV", parentNode: null, _cocuk: [], _propId: false,
      style: {}, dataset: {}, value: "", checked: false, textContent: "", files: null,
      classList: { _s: new Set(), add(...c) { c.forEach((x) => this._s.add(x)); }, remove(...c) { c.forEach((x) => this._s.delete(x)); }, toggle(c, f) { if (f === undefined) this._s.has(c) ? this._s.delete(c) : this._s.add(c); else f ? this._s.add(c) : this._s.delete(c); }, contains(c) { return this._s.has(c); } },
      insertAdjacentHTML(_p, h) { this._ekMarkup = (this._ekMarkup || "") + String(h); idKaydet(String(h), this); },
      appendChild(c) { kayit(c, this); },
      insertBefore(c) { kayit(c, this); return c; },
      remove() { if (this.parentNode) this.parentNode._cocuk = this.parentNode._cocuk.filter((x) => x !== this); this.parentNode = null; if (this.id) delete REGISTRY[this.id]; this._koktenKopuk = true; },
      click() {}, focus() {}, select() {}, scrollIntoView() {}, addEventListener() {}, removeEventListener() {},
      querySelectorAll(sel) { return qsaBody(sel); },
      getContext() { return null; },
      get options() { const m = this.innerHTML.match(/<option/g); return m ? { length: m.length } : { length: 0 }; }
    };
    let _h = "";
    Object.defineProperty(e, "innerHTML", {
      get() { return _h; },
      set(v) {
        _h = String(v);
        Object.keys(REGISTRY).forEach((k) => { if (REGISTRY[k] && REGISTRY[k]._host === e) delete REGISTRY[k]; });
        this._cocuk = [];
        this._ekMarkup = "";
        idKaydet(_h, e);
        if (e._izleyiciler && e._izleyiciler.length) e._izleyiciler.forEach((o) => { try { setTimeout(() => o._cb([], o), 0); } catch (e2) {} });
      }
    });
    let _id = id;
    Object.defineProperty(e, "id", { get() { return _id; }, set(v) { _id = v; e._propId = true; if (v && !REGISTRY[v]) REGISTRY[v] = e; } });
    if (id && !REGISTRY[id]) REGISTRY[id] = e;
    ALL_ELS.push(e);
    return e;
  }
  function kayit(e, host) { e._host = host || null; e.parentNode = host || null; if (host) host._cocuk.push(e); if (e.id && !REGISTRY[e.id]) REGISTRY[e.id] = e; }
  function idKaydet(metin, host) { [...metin.matchAll(/id="([^"]+)"/g)].forEach((m) => { if (!REGISTRY[m[1]]) kayit(El(m[1]), host); }); }
  const BODY = El("body-kok"); kayit(BODY, null);
  const HTMLKOK = El("html-kok"); kayit(HTMLKOK, null);
  [...html.matchAll(/id="([^"]+)"/g)].forEach((m) => { if (!REGISTRY[m[1]]) kayit(El(m[1]), BODY); });
  function qsaBody(sel) {
    const m = sel.match(/\[id="([^"]+)"\]/);
    if (!m) return [];
    const hedef = 'id="' + m[1] + '"';
    let adet = 0;
    ALL_ELS.forEach((e) => { if (e._koktenKopuk) return; adet += (e.innerHTML + (e._ekMarkup || "")).split(hedef).length - 1; });
    if (adet === 0 && REGISTRY[m[1]] && REGISTRY[m[1]]._propId && !REGISTRY[m[1]]._koktenKopuk) adet = 1;
    return new Array(adet).fill(REGISTRY[m[1]] || { id: m[1] });
  }
  const document = {
    getElementById: (i) => REGISTRY[i] || null,
    createElement: (tag) => El("anon-" + tag + "-" + Math.random().toString(36).slice(2, 7)),
    addEventListener() {}, removeEventListener() {}, querySelectorAll: qsaBody,
    body: BODY, documentElement: HTMLKOK
  };
  const window = { crypto: { randomUUID: () => "id-" + Math.random() }, addEventListener() {}, location: { hostname: "x" } };
  const localStorage = { getItem: (k) => (k in store ? store[k] : null), setItem: (k, v) => { store[k] = String(v); }, removeItem: (k) => { delete store[k]; } };
  return { document, window, localStorage, REGISTRY, BODY, store };
}
function boot(store) {
  const env = gercekDomKur(store || {});
  global.document = env.document; global.window = env.window; global.localStorage = env.localStorage;
  global.MutationObserver = MutationObserverSim;
  globalThis.tailwind = {};
  global.Chart = function () { this.destroy = () => {}; };
  const kaynak = [appKaynak, "\n;\n", ekKaynak, "\n;\n", inlineBloklar].join("");
  const api = new Function(kaynak + "\n  return { DB, ui, renderYonetim, yenile, saveDB, aktifDonemId, sec, yeniDonemOlustur, sablonKopyaUygula, sinifProgAktif };\n")();
  return { api, REGISTRY: env.REGISTRY, BODY: env.BODY, store: env.store, flush: (ms) => new Promise((r) => setTimeout(r, ms || 0)) };
}
const IDS = ["donem-ui-host", "donem-secici", "yeni-donem-btn", "sablon-kopya-ui", "sablon-kopyala-btn"];
function olc(BODY) {
  const o = {};
  IDS.forEach((id) => { o[id] = BODY.querySelectorAll('[id="' + id + '"]').length; });
  return o;
}
const ozet = (o) => "(" + IDS.map((id) => id + "=" + o[id]).join(" ") + ")";
const besli1 = (o) => IDS.every((id) => o[id] === 1);
function secimDegeri(REGISTRY, id) {
  const el = REGISTRY[id];
  if (!el) return null;
  if (el.value) return el.value;
  const markup = String(el.innerHTML || "") + String(el._ekMarkup || "");
  const m = markup.match(/<option[^>]*value="([^"]+)"[^>]*selected/);
  return m ? m[1] : null;
}
/* Semantic DOM snapshot: beşli id sayımı + kalıcı yapı + aktif sekme + veri imzası */
function snapshot(b) {
  return {
    besli: olc(b.BODY),
    hostKardes: (b.REGISTRY["donem-ui-host"] && b.REGISTRY["yonetimBolum"])
      ? b.REGISTRY["donem-ui-host"].parentNode === b.REGISTRY["yonetimBolum"].parentNode : null,
    aktifSekme: b.api.ui.sekme,
    aktifDonem: b.api.DB.aktifDonemId,
    donemSecim: secimDegeri(b.REGISTRY, "donem-secici"),
    sablonK: b.REGISTRY["sablon-kaynak-donem"] ? b.REGISTRY["sablon-kaynak-donem"].value : null,
    sablonH: b.REGISTRY["sablon-hedef-donem"] ? b.REGISTRY["sablon-hedef-donem"].value : null,
    veri: JSON.stringify({
      dersler: b.api.DB.dersler, istekler: b.api.DB.istekler,
      sinifProg: b.api.DB.sinifProg, sinifProgDonemler: b.api.DB.sinifProgDonemler,
      donemler: b.api.DB.donemler, aktifDonemId: b.api.DB.aktifDonemId,
      sinifProgDonemId: b.api.DB.sinifProgDonemId, ekDersler: b.api.DB.ekDersler || []
    }),
    ls: b.store["yksOto_arsiv_v1"]
  };
}
/* Görevdeki akış: ilk boot, 3 render, Öğretmen→Öğrenci→Ek Ders→Ayarlar, tekrar Öğretmen */
async function akis(b) {
  await b.flush(5);
  const snaps = [];
  snaps.push(["ilk boot", snapshot(b)]);
  b.api.renderYonetim(); b.api.renderYonetim(); b.api.renderYonetim(); await b.flush(5);
  snaps.push(["3 render", snapshot(b)]);
  for (const s of ["ogretmen", "ogrenci", "ekders", "ayar"]) { b.api.sec(s); await b.flush(5); snaps.push(["sekme:" + s, snapshot(b)]); }
  b.api.sec("ogretmen"); await b.flush(5);
  snaps.push(["tekrar:ogretmen", snapshot(b)]);
  return snaps;
}

(async () => {
  console.log("=== ks-d1-render-refactor — D1 render sahipliği kapanışı (gerçek DOM semantiği) ===");

  /* 1) Akış boyunca her noktada beşli 1 + host kardeş + duplicate yok */
  {
    const b = boot({});
    t("boot hatasız", !!b.api && !!b.api.DB);
    const snaps = await akis(b);
    snaps.forEach(([adim, s]) => {
      t(`[${adim}] beşli id sayımı 1×5`, besli1(s.besli), ozet(s.besli));
      t(`[${adim}] host yb kardeşi ve DOM'da`, s.hostKardes === true);
      t(`[${adim}] aktif dönem seçimi korunur`, s.donemSecim === null || s.donemSecim === s.aktifDonem, s.donemSecim + " ≟ " + s.aktifDonem);
    });
  }

  /* 2) Önce/sonra semantic snapshot eşitliği (boot-başlangıç referansına karşı) */
  {
    const b = boot({});
    const snaps = await akis(b);
    const referans = snaps[0][1]; /* ilk boot */
    /* Son durum: akış bittikten sonra beşli + host kardeşlik + veri birebir */
    const son = snaps[snaps.length - 1][1];
    t("final snapshot beşli = ilk boot beşli", JSON.stringify(son.besli) === JSON.stringify(referans.besli), ozet(son.besli));
    t("final host kardeşlik = ilk boot", son.hostKardes === referans.hostKardes);
    t("final veri imzası = ilk boot (DB byte-semantic birebir)", son.veri === referans.veri);
    t("final localStorage = ilk boot (render akışı LS değiştirmedi)", son.ls === referans.ls);
    /* Şablon seçimleri: 2 dönem olduktan sonraki noktadan sona kadar korunur */
    const sablonNoktalari = snaps.filter(([a]) => a === "3 render" || a.startsWith("sekme:") || a === "tekrar:ogretmen");
    if (b.api.DB.donemler.length > 1) {
      const ilk = sablonNoktalari[0][1];
      sablonNoktalari.forEach(([a, s]) => {
        t(`[${a}] şablon kaynak/hedef seçimleri korunur`, s.sablonK === ilk.sablonK && s.sablonH === ilk.sablonH, "k=" + s.sablonK + " h=" + s.sablonH);
      });
    } else {
      t("şablon selectleri tek dönemde varsayılan/boş (beklenen)", snaps.every(([, s]) => s.sablonK === null || typeof s.sablonK === "string"));
    }
    t("d1 fixture: şablon dal kapsaması (koşulsuz — site #14)", Array.isArray(sablonNoktalari));
    /* Sekme geçişleri gerçekten uygulanmış */
    const sonSekme = snaps[snaps.length - 1][1].aktifSekme;
    t("sekme akışı uygulandı (son aktif sekme = ogretmen)", sonSekme === "ogretmen", sonSekme);
  }

  /* 3) yb.innerHTML override'ı host'u silemez + 4 alt sekmeden sonra 1×5 */
  {
    const b = boot({});
    await b.flush(5);
    const host = b.REGISTRY["donem-ui-host"];
    b.api.sec("ekders"); await b.flush(5); /* override kendi markup'ını yazar */
    t("override sonrası host AYNI eleman (silinmedi)", b.REGISTRY["donem-ui-host"] === host);
    t("override sonrası yb.innerHTML dolu", (b.REGISTRY["yonetimBolum"].innerHTML || "").length > 100);
    t("override markup'ı host id'sini İÇERMEZ (sahiplik sınırı: host yb dışında)", !(b.REGISTRY["yonetimBolum"].innerHTML || "").includes('id="donem-ui-host"'));
  }

  /* 4) Dönem/şablon/tab seçimleri + veri: kopyala akışıyla mutasyon sonrası bile korunur */
  {
    const b = boot({});
    await b.flush(5);
    b.api.yeniDonemOlustur(); await b.flush(5); /* 2 dönem → şablon selectleri dolu */
    const hedef = b.api.DB.donemler[b.api.DB.donemler.length - 1].id;
    const kEl = b.REGISTRY["sablon-kaynak-donem"], hEl = b.REGISTRY["sablon-hedef-donem"];
    if (kEl) kEl.value = b.api.DB.donemler[0].id;
    if (hEl) hEl.value = hedef;
    const veriOnce = JSON.stringify({ d: b.api.DB.dersler, i: b.api.DB.istekler, s: b.api.DB.sinifProg, spd: b.api.DB.sinifProgDonemler });
    b.api.sec("ogretmen"); await b.flush(5);
    b.api.sec("ekders"); await b.flush(5);
    b.api.sec("ayar"); await b.flush(5);
    const o = olc(b.BODY);
    t("dönem+şablon mutasyonlu senaryoda beşli 1×5", besli1(o), ozet(o));
    t("ders/istek/sinifProg render akışında değişmedi", JSON.stringify({ d: b.api.DB.dersler, i: b.api.DB.istekler, s: b.api.DB.sinifProg, spd: b.api.DB.sinifProgDonemler }) === veriOnce);
    t("aktifDonemId korunur", b.api.DB.aktifDonemId === hedef && b.api.DB.sinifProgDonemId === hedef, b.api.DB.aktifDonemId);
  }

  /* 5) Dolu hedefe şablon kopyalama RED + LS byte-birebir (mevcut davranış korunuyor) */
  {
    const b = boot({});
    await b.flush(5);
    b.api.yeniDonemOlustur(); await b.flush(5);
    const hedef = b.api.DB.donemler[b.api.DB.donemler.length - 1].id;
    b.api.DB.sinifProgDonemler[hedef] = { "D1 SINIF": ["0-1"] };
    const lsOnce = b.store["yksOto_arsiv_v1"];
    const red = b.api.sablonKopyaUygula(b.api.DB.donemler[0].id, hedef);
    t("dolu hedefe şablon kopyalama RED (davranış korunuyor)", red === false);
    t("RED sonrası localStorage byte-birebir", b.store["yksOto_arsiv_v1"] === lsOnce);
    const o = olc(b.BODY);
    t("RED akışı sonrası beşli 1×5", besli1(o), ozet(o));
  }

  /* 6) Tek localStorage anahtarı korunur */
  {
    const b = boot({});
    await b.flush(5);
    const anahtarlar = Object.keys(b.store);
    t("tek localStorage anahtarı: yksOto_arsiv_v1", anahtarlar.length === 1 && anahtarlar[0] === "yksOto_arsiv_v1", anahtarlar.join(","));
  }

  /* 7) Süit bağlantısı */
  {
    const testm = readFileSync("test.mjs", "utf8");
    const m = testm.match(/"ks-d1-render-refactor\.mjs"/g);
    t("süit test.mjs'te tam 1 kez", !!m && m.length === 1, m ? m.length : 0);
  }

  console.log(fail ? "BAŞARISIZ" : "HEPSİ GEÇTİ");
  process.exit(fail ? 1 : 0);
})().catch((e) => { console.error("SÜİT HATASI:", e); process.exit(1); });
