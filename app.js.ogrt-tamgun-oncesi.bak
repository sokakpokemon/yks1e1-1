function kimlikUret(tur, i) {
  return "ks-" + String(tur).slice(0, 3) + "-" + String(i + 1).padStart(4, "0") + "-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 8);
}
/* DB'deki eksik/çakışan ID'leri tek geçişte tamamlar; IDEMPOTENT: geçerli id'lere ASLA dokunmaz.
   Dönüş: { o: eklenen öğrenci, t: eklenen öğretmen, s: eklenen sınıf } sayıları (değişiklik yoksa 0). */
function kimlikleriTamamla(db) {
  db = db || DB;
  if (!db || typeof db !== "object") return { o: 0, t: 0, s: 0 };
  var say = { o: 0, t: 0, s: 0 };
  function benzersiz(aday) {
    var k = String(aday), n = 2;
    function cakisiyor(h) { return db.ogrenciler.some(function (x) { return x.id === h; }) || db.ogretmenler.some(function (x) { return x.id === h; }) || (db.sinifIds && db.sinifIds[h] != null); }
    while (cakisiyor(k)) k = String(aday) + "-" + (n++);
    return k;
  }
  /* Öğrenci ve öğretmen id'leri — mevcut geçerli değerler KORUNUR (öncelik: sıradaki boot'ta aynen kalır) */
  (Array.isArray(db.ogrenciler) ? db.ogrenciler : []).forEach(function (o, i) {
