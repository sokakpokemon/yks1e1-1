    .filter(function (ad) { return ad; });
}
function grupUyeEtiketleri(ders) {
  /* [ana ogrenciId, ...ek] sırasından: ana HARİÇ badge üyeleri (ek adları; ana formda tam ad) */
  if (!ders || !Array.isArray(ders.ogrenciIds) || !ders.ogrenciIds.length) return [];
  return ders.ogrenciIds
