  (Array.isArray(db.ogrenciler) ? db.ogrenciler : []).forEach(function (o) { if (o && o.sinif) adlar[o.sinif] = 1; });
  if (Array.isArray(db.ekDersler)) db.ekDersler.forEach(function (l) { if (l && l.sinif) adlar[l.sinif] = 1; });
  if (Array.isArray(db.ogretmenler)) db.ogretmenler.forEach(function (t) {
