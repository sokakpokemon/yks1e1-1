    { id: uid(), ad: "TAHSİN ASLAN", brans: "mat", avail: { sinif: {"0-1":"12 SAY 2","2-1":"12 SAY CAL","3-1":"12 EA 1","4-1":"12 DİL"}, musait: ["5-1","0-2"] } },
