    { id: uid(), ad: "EREN BİLGİLİ", brans: "tur", avail: { sinif: {"0-1":"MEZUN SAY 1","1-1":"MEZUN SAY 2","2-1":"MEZUN SAY 3","3-1":"MEZUN EA 1"}, musait: ["4-1","5-1"] } },
